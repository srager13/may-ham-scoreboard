# ============================================
# SYSTEMD SERVICE FILES (Linux - Recommended)
# ============================================

# File: /etc/systemd/system/golf-api.service
# Install as root: sudo cp golf-api.service /etc/systemd/system/
# Then enable: sudo systemctl enable golf-api.service
# Start service: sudo systemctl start golf-api.service

[Unit]
Description=Golf Tournament API Service
After=network.target postgresql.service
Wants=postgresql.service
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=10
User=golftournament
Group=golftournament
WorkingDirectory=/opt/golf-tournament/backend
EnvironmentFile=/opt/golf-tournament/backend/.env.production
  # Create uploads directory before starting the service. PermissionsStartOnly
  # causes ExecStartPre commands to run as root while the main process runs as
  # the specified User/Group.
  PermissionsStartOnly=true
  ExecStartPre=/bin/mkdir -p /srv/golf-api/uploads
  ExecStartPre=-/bin/chown -R golftournament:golftournament /srv/golf-api/uploads
  ExecStartPre=-/bin/chmod -R 0755 /srv/golf-api/uploads
  ExecStart=/opt/golf-tournament/backend/mayhamapi

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/golf-tournament /var/backups/golf-tournament /srv/golf-api/uploads
RuntimeDirectory=golf-tournament
RuntimeDirectoryMode=0755

# Resource limits
LimitNOFILE=65536
MemoryMax=1G

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=golf-api

[Install]
WantedBy=multi-user.target
